# CodeSentinel AI Environment Variables

# --- Django Settings ---
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM Provider Settings (openai or bedrock) ---
LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
AWS_PROFILE=eazyq-prod

# Bedrock inference-profile IDs (ap-south-1 -> `apac.` prefix). Confirm the
# exact -vN:0 suffix + model access in the AWS Bedrock console at wiring time.
BEDROCK_MODEL_REASONING=apac.anthropic.claude-sonnet-4-6-v1:0
BEDROCK_MODEL_PLANNING=apac.anthropic.claude-opus-4-8-v1:0
BEDROCK_MODEL_ROUTING=apac.anthropic.claude-haiku-4-5-v1:0

# Auth (SigV4 IAM or a Bedrock bearer token). Leave unset for offline dev.
# AWS_BEARER_TOKEN_BEDROCK=

# --- Context Engine ---
CONTEXT_WINDOW_LINES=20
CONTEXT_MAX_TOKENS=8000
MCP_SERVER_SCRIPT=../mcp_server/server.py

# --- API ---
CODESENTINEL_API=http://localhost:8000
